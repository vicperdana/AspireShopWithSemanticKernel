# Environment Variables Example

# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Database (if overriding defaults)
# PostgreSQL connection managed by Aspire; typically not needed in .env

# Redis (if overriding defaults)
# Redis connection managed by Aspire; typically not needed in .env

# Application URLs
CHECKOUT_SUCCESS_URL=https://localhost:5001/checkout/success
CHECKOUT_CANCEL_URL=https://localhost:5001/checkout/cancel

# Throttling Configuration
CHAT_THROTTLE_MAX_REQUESTS=30
CHAT_THROTTLE_WINDOW_MINUTES=1
PAYMENT_SESSION_GUARD_WINDOW_MINUTES=2

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LOG_LEVEL=Information

# Notes:
# - Copy this file to `Shared/.env` and replace placeholder values
# - DO NOT commit .env file to version control
# - Use Azure Key Vault for production secrets
