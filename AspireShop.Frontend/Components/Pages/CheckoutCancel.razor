@page "/checkout/cancel"

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body text-center">
                    <i class="bi bi-x-circle-fill text-warning" style="font-size: 4rem;"></i>
                    <h2 class="card-title mt-3">Checkout Cancelled</h2>
                    <p class="card-text">
                        Your checkout session was cancelled. No charges were made to your account.
                    </p>
                    
                    <div class="mt-4">
                        <a href="/" class="btn btn-primary">Return to Shop</a>
                        <a href="/basket" class="btn btn-outline-secondary ms-2">View Basket</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
}
