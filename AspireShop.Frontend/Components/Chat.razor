@using System.Diagnostics.CodeAnalysis
@using Microsoft.SemanticKernel
@using Microsoft.SemanticKernel.ChatCompletion
@inject ChatServiceClient ChatServiceClient
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<div class="chatbot-container">
    <button class="chatbot-button" @onclick="ToggleChat">
        <i class="fa fa-comments"></i>
    </button>

    @if (isChatOpen)
    {
        <div class="title">AspireShop Smart</div>
        <div class="box">
            @foreach (var message in messages)
            {
                <text>@((MarkupString)($"<div class=\"msg\">{message}</div><p/>"))</text>
            }
            @if (isThinking)
            {
                <text>@((MarkupString)"<div class=\"msg\">AspireShop is thinking<span class='dots'>...</span></div><p/>")</text>
            }
            
        </div>
    <div class="typing-area">
        <div class="input-field">
            <input type="text" @bind="inputMessage" placeholder="Type a message..."/>
            <button @onclick="Send" class="send-button">Send</button>
        </div>
        <button class="voice-input-button" @onclick="StartVoiceInput" aria-label="Start voice input">🎤</button>
    </div>

    }
</div>

@code {
    private bool isChatOpen = false;
    private string inputMessage = string.Empty;
    private List<string> messages = new List<string>();
    private ChatHistory history = [];
    private bool isThinking = false;
    private string initialMessage = "AspireShop: Welcome to AspireShop! I can help you with browsing the catalog item, say the item you're looking for and I'll help you navigate to the correct catalog items.";

    private void ToggleChat()
    {
        isChatOpen = !isChatOpen;
        Console.WriteLine($"ToggleChat called. isChatOpen is now {isChatOpen}");
        StateHasChanged();
    }

    protected override Task OnInitializedAsync()
    {
        isThinking = true;
        messages.Add(initialMessage);
        history.AddSystemMessage(initialMessage);
        isThinking = StopThinking();
        return Task.CompletedTask;
    }

    #pragma warning disable SKEXP0001
    private async Task Send()
    {
        if (!string.IsNullOrEmpty(inputMessage))
        {
            isThinking = true;
            var response = await ChatServiceClient.SendMessage(inputMessage);
            messages.Add("You: " + inputMessage);
            
            messages.Add("AspireShop: "+response!.message.Replace("\n", "<br/>"));
            history.AddUserMessage(inputMessage);
            history.AddAssistantMessage(response.message);
            inputMessage = string.Empty;
            if (response.intent is not null)
            {
                string searchText = response.intent;
                NavigationManager.NavigateTo("/?searchText=" + searchText);
            }
            //Play audio response
            //await Speak(response.message);
            #pragma warning disable SKEXP0001
            await SpeakWithOpenAI(response.audioContent);
            #pragma warning restore SKEXP0001
            //Reload the catalog and pass it on to the Home page
            isThinking = StopThinking();
        }
    }
#pragma warning restore SKEXP0001
    
    async Task KeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {   
#pragma warning disable SKEXP0001
            await Send();
#pragma warning restore SKEXP0001
        }
    }

    private bool StopThinking()
    {   
        StateHasChanged();
        return false;
    }
    
    private async Task StartVoiceInput()
    {
        await JSRuntime.InvokeVoidAsync("speechRecognition.startRecognition", DotNetObjectReference.Create(this));
    }

    [JSInvokable]
    public async Task ReceiveSpeechInput(string transcript)
    {
        inputMessage = transcript;
#pragma warning disable SKEXP0001
        await Send();
#pragma warning restore SKEXP0001
        isThinking = StopThinking();
    }
    
    private async Task Speak(string message)
    {
        // Robotic sound
        await JSRuntime.InvokeVoidAsync("customSpeechSynthesis.speakText", message);
    }
    
    #pragma warning disable SKEXP0001
    private async Task SpeakWithOpenAI(byte[] audio)
    {
        if (audio == null || audio.Length == 0)
        {
            Console.WriteLine("Audio content is null or has no data. Cannot play audio.");
            return;
        }

        try
        {
            // Convert the nullable byte array to a base64 string
            string base64Mp3 = Convert.ToBase64String(audio);

            // Convert the base64 string to a data URL
            string dataUrl = $"data:audio/mp3;base64,{base64Mp3}";

            // Call JavaScript to play the audio
            await JSRuntime.InvokeVoidAsync("customSpeechSynthesis.playAudio", dataUrl);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in SpeakWithOpenAI: {ex.Message}");
        }
    }
#pragma warning restore SKEXP0001

}